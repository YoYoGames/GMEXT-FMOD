# VS and VSC folders
**/.vs/
**/.vsc/

# Common extensions
**/*.exp
**/*.ilk
**/*.lib
**/*.pdb
**/*.exp
**/*.exe

# FMOD SDKs
source/fmod_sdk/

# FMOD DEMO options
source/fmod_gml/options/

# FMOD SDK redistributables. The build-step scripts stage these at game-build time,
# so they must never be committed - they are FMOD's to distribute, not ours. Matched
# on filename rather than on an extension folder path: the previous rules were scoped
# to extensions/FMOD/ and stopped matching the moment that folder was split in two.
source/fmod_gml/extensions/**/fmod.dll
source/fmod_gml/extensions/**/fmodL.dll
source/fmod_gml/extensions/**/fmodstudio.dll
source/fmod_gml/extensions/**/fmodstudioL.dll
source/fmod_gml/extensions/**/libfmod*.so*
source/fmod_gml/extensions/**/libfmod*.dylib
source/fmod_gml/extensions/**/fmod.jar
source/fmod_gml/extensions/**/*.aar
source/fmod_gml/extensions/**/Fmod Core/
source/fmod_gml/extensions/**/Fmod Studio/

# Console binaries. pre_build_step builds them from source/ at game-build time and the
# generated cmake/<platform>/extgen_post_build.cmake drops them next to the .yy - never
# committed, same as the staged FMOD runtimes above. metadata.json's postRemovals carries
# the same globs (minus the source/fmod_gml/ prefix) so the package strips them too - a
# product renamed here is renamed there in the same change.
source/fmod_gml/extensions/**/*_xboxone.dll
source/fmod_gml/extensions/**/*_xboxseriesxs.dll
source/fmod_gml/extensions/**/*.prx
source/fmod_gml/extensions/**/*.nro
source/fmod_gml/extensions/**/*.nrr
source/fmod_gml/extensions/**/*.nrs

# Native build tree (CMake presets configure into source/out/)
source/fmod_gml/extensions/**/source/out/

# XCode and VS userdata
*.user
xcuserdata/

# Igor artifacts
*.sh-e

# Output and Build folders
output/
source/fmod_gml/Build/

# Backup files
source/fmod_gml/extensions/**/*.bak

# The two .dylib placeholders both .yy files declare as extension files. They are zero-byte
# on purpose - post_build_step writes the real bytes at game-build time - but GameMaker needs
# them present to reference them in the generated Xcode project.
!source/fmod_gml/extensions/GMFMOD/libfmod.dylib
!source/fmod_gml/extensions/GMFMODStudio/libfmodstudio.dylib
