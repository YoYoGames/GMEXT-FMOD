// Payloads carried by the third argument of an event callback. Which one
// arrives is selected by the FmodStudioEventCallbackType that fired; the types
// that carry nothing pass undefined instead.

[global]
class `[[FmodStudioTimelineMarkerProperties]]` prototype Object
{
    [field, type_hint=`string`]
    property name: gmval { get; set; }

    [field, type_hint=`real`]
    property position: gmval { get; set; }
}

[global]
class `[[FmodStudioTimelineBeatProperties]]` prototype Object
{
    [field, type_hint=`real`]
    property bar: gmval { get; set; }

    [field, type_hint=`real`]
    property beat: gmval { get; set; }

    [field, type_hint=`real`]
    property position: gmval { get; set; }

    [field, type_hint=`real`]
    property tempo: gmval { get; set; }

    [field, type_hint=`real`]
    property time_signature_upper: gmval { get; set; }

    [field, type_hint=`real`]
    property time_signature_lower: gmval { get; set; }
}

// FMOD_STUDIO_TIMELINE_NESTED_BEAT_PROPERTIES nests a beat struct; GMIDL
// classes are flat, so the beat fields are inlined alongside the event id.
[global]
class `[[FmodStudioTimelineNestedBeatProperties]]` prototype Object
{
    [field, type_hint=`string`]
    property event_id: gmval { get; set; }

    [field, type_hint=`real`]
    property bar: gmval { get; set; }

    [field, type_hint=`real`]
    property beat: gmval { get; set; }

    [field, type_hint=`real`]
    property position: gmval { get; set; }

    [field, type_hint=`real`]
    property tempo: gmval { get; set; }

    [field, type_hint=`real`]
    property time_signature_upper: gmval { get; set; }

    [field, type_hint=`real`]
    property time_signature_lower: gmval { get; set; }
}

// FMOD's own struct also carries the sound the callback must supply, and GML
// callbacks here run a frame late, so the extension supplies it itself from
// the key registered with fmod_studio_event_instance_set_programmer_sound().
// `result` is this extension's own field: the FMOD_RESULT of that create (on
// CreateProgrammerSound) or release (on DestroyProgrammerSound), and Ok when no
// key was registered and nothing was attempted.
[global]
class `[[FmodStudioProgrammerSoundProperties]]` prototype Object
{
    [field, type_hint=`string`]
    property name: gmval { get; set; }

    [field, type_hint=`real`]
    property sub_sound_index: gmval { get; set; }

    [field, type_hint=`FmodStudioResult`]
    property result: gmval { get; set; }
}

// FMOD's own struct also carries the plugin DSP. It belongs to the GMFMOD
// registry, not this one, so a ref minted here would be meaningless there.
[global]
class `[[FmodStudioPluginInstanceProperties]]` prototype Object
{
    [field, type_hint=`string`]
    property name: gmval { get; set; }
}

group
{

// ============================================================
// Studio System - Lifetime
// ============================================================

[global, bind = typed_gml, type_hint=`uint64`]
function fmod_studio_system_create(): gmval;

[global, bind = typed_gml]
function fmod_studio_system_init(max_channels: real, [type_hint=`FmodStudioInitFlags`] studio_flags: gmval, [type_hint=`FmodStudioCoreInitFlags`] core_flags: gmval): real;

[global, bind = typed_gml]
function fmod_studio_system_release(): real;

[global, bind = typed_gml]
function fmod_studio_system_update(): real;

[global, bind = typed_gml]
function fmod_studio_system_flush_commands(): real;

[global, bind = typed_gml]
function fmod_studio_system_flush_sample_loading(): real;

// ============================================================
// Studio System - Banks
// ============================================================

[global, bind = typed_gml, type_hint=`uint64?`]
function fmod_studio_system_load_bank_file(filename: string, [type_hint=`FmodStudioLoadBankFlags`] flags: gmval): gmval;

// FMOD_STUDIO_LOAD_MEMORY is forced on: FMOD copies the data, so the buffer
// can be freed as soon as this returns. FMOD_STUDIO_LOAD_MEMORY_POINT is
// deliberately not exposed - it needs a 32-byte-aligned address and the buffer
// alive until the bank finishes unloading, neither of which GML can promise.
// `length` of 0 or less means the whole buffer.
[global, bind = typed_gml, type_hint=`uint64?`]
function fmod_studio_system_load_bank_memory(
    [type_hint=buffer] data: gmval,
    length: real,
    [type_hint=`FmodStudioLoadBankFlags`] flags: gmval
): gmval;

