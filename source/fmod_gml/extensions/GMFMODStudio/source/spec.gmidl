function fmod_studio_system_get_parameter_by_name(name: string): gmval;

// Raw FMOD::System* of the Studio-owned core system, as an integer. A pointer,
// not a ref, is how a handle crosses the DLL boundary: GMFMOD links its own
// registry, and because both extensions pack refs identically a ref minted
// here would resolve against the wrong map rather than fail. Pass this pointer
// to fmod_system_adopt() (GMFMOD) to register the same system there.
[global, bind = typed_gml, type_hint=`uint64`]
function fmod_studio_system_get_core_system_ptr(): gmval;

// Result of the last call into THIS extension. GMFMOD's fmod_last_result()
// reads the core DLL's own state and never reflects a Studio call, so Studio
// failures are invisible without this.
[global, bind = typed_gml, type_hint=`FmodStudioResult`]
function fmod_studio_last_result(): gmval;

// finish_fn: the runtime calls this on game end and on game_restart(). Releasing
// the Studio system also releases the core system it owns, which is the same
// object GMFMOD may hold as an adopted system.
[global, finish_fn, bind = typed_gml]
function fmod_studio_shutdown(): unit;

[global, bind = typed_gml]
function fmod_studio_system_set_num_listeners(count: real): real;

