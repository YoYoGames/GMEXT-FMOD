{

// ============================================================
// Utility Functions
// ============================================================

[global, bind = typed_gml, type_hint=`FmodResult`]
function fmod_last_result(): gmval;

[global, bind = typed_gml]
function fmod_debug_initialize(
    [type_hint=`FmodDebugFlags`] flags: gmval,
    [type_hint=`FmodDebugMode`] mode: gmval
): unit;

[global, bind = typed_gml]
function fmod_path_bundle(filename: string): string;

[global, bind = typed_gml]
function fmod_path_user(filename: string): string;

}

