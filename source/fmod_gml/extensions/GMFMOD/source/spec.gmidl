// Data Return Types
// ============================================================

[global]
class `[[FmodSoundDefaults]]` prototype Object
{
    [field, type_hint=`real`]
    property frequency: gmval { get; set; }

    [field, type_hint=`real`]
    property priority: gmval { get; set; }
}

[global]
class `[[FmodLoopPoints]]` prototype Object
{
