[global, bind = typed_gml]
enum FmodStudioLoadingState
{
	Unloading = 0,
	Unloaded = 1,
	Loading = 2,
	Loaded = 3,
	Error = 4,
}

[global, bind = typed_gml]
enum FmodStudioPlaybackState
{
	Playing = 0,
