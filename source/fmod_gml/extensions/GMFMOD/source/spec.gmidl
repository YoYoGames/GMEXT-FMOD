[gml_api]
module GMFMOD;

// ============================================================
// Enums and Constants
// ============================================================

[global, bind = typed_gml]
enum FmodResult
{
	Ok = 0,
	BadCommand = 1,
	ChannelAlloc = 2,
	ChannelStolen = 3,
	Dma = 4,
	DspConnection = 5,
	DspDontProcess = 6,
	DspFormat = 7,
	DspInUse = 8,
