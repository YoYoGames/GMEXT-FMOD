	ReverbInstance = 59,
	SubSounds = 60,
	SubSoundAllocated = 61,
	SubSoundCantMove = 62,
	TagNotFound = 63,
	TooManyChannels = 64,
	TruncatedData = 65,
	Unimplemented = 66,
	Uninitialized = 67,
	Unsupported = 68,
	Version = 69,
	EventAlreadyLoaded = 70,
	EventLiveUpdateBusy = 71,
	EventLiveUpdateMismatch = 72,
	EventLiveUpdateTimeout = 73,
	EventNotFound = 74,
