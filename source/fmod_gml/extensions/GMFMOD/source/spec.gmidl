	DspReserved = 10,
	DspSilence = 11,
	DspType = 12,
	FileBad = 13,
	FileCouldNotSeek = 14,
	FileDiskEjected = 15,
	FileEof = 16,
	FileEndOfData = 17,
	FileNotFound = 18,
	FileUnwanted = 19,
	FormatUnsupported = 20,
	Generic = 21,
	InvalidHandle = 22,
	InvalidParam = 23,
	InvalidPosition = 24,
	InvalidSpeakerMode = 25,
	InvalidThread = 26,
	InvalidVector = 27,
	MaxAudioEngines = 28,
	Memory = 29,
	MemoryCantPoint = 30,
	Needs3D = 31,
	NeedsSoftware = 32,
	NetConnect = 33,
	NetSocketError = 34,
	NetUrl = 35,
