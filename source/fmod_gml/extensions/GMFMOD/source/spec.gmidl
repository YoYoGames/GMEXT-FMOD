[gml_api]
module GMFMOD;

// ============================================================
// Reference Types
// ============================================================

[global]
class `[[FmodChannelRef]]` prototype Object
{
    [field, type_hint=`uint64`]
    property _ref: gmval { get; set; }
}

[global]
class `[[FmodChannelGroupRef]]` prototype Object
{
    [field, type_hint=`uint64`]
    property _ref: gmval { get; set; }
}

[global]
class `[[FmodSoundRef]]` prototype Object
{
    [field, type_hint=`uint64`]
    property _ref: gmval { get; set; }
}

[global]
class `[[FmodSystemRef]]` prototype Object
{
    [field, type_hint=`uint64`]
    property _ref: gmval { get; set; }
}

